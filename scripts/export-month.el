;;; export-month.el -*- lexical-binding: t; -*-
(require 'org)
(require 'ox-latex)
(let* ((year (format-time-string "%Y" nil "Europe/Madrid"))
       (month (format-time-string "%m" nil "Europe/Madrid"))
       (dir (expand-file-name (format "articulos/%s/%s" year month)))
       (sources (and (file-directory-p dir)
                     (sort (directory-files dir t "^[0-9].*\\.org$") #'string<)))
       (temp (expand-file-name "monthly-export.org" dir))
       (dest (expand-file-name (format "dist/graficos-%s-%s.pdf" year month)))
       (org-latex-compiler "xelatex")
       (org-latex-pdf-process
        '("xelatex -interaction=nonstopmode -halt-on-error -output-directory=%o %f"
          "xelatex -interaction=nonstopmode -halt-on-error -output-directory=%o %f")))
  (unless sources (error "No Org articles in %s" dir))
  (make-directory (file-name-directory dest) t)
  (unwind-protect
      (progn
        (with-temp-file temp
          (insert (format "#+TITLE: Gráficos por computador - %s-%s\n" year month))
          (insert "#+LANGUAGE: es\n#+LATEX_CLASS: report\n#+LATEX_COMPILER: xelatex\n")
          (insert "#+OPTIONS: toc:2 num:t\n")
          (insert "#+LATEX_HEADER: \\usepackage[spanish]{babel}\n")
          (insert "#+LATEX_HEADER: \\usepackage{fontspec}\n")
          (insert "#+LATEX_HEADER: \\setmainfont{DejaVu Serif}\n")
          (insert "#+LATEX_HEADER: \\setmonofont{DejaVu Sans Mono}\n\n")
          (dolist (f sources)
            (with-temp-buffer
              (insert-file-contents f)
              (let ((title (file-name-base f)))
                (goto-char (point-min))
                (when (re-search-forward "^#\\+TITLE: *\\(.*\\)$" nil t)
                  (setq title (match-string-no-properties 1)))
                (goto-char (point-min))
                (while (re-search-forward "^#\\+\\(TITLE\\|DATE\\|LANGUAGE\\|FILETAGS\\|STARTUP\\|OPTIONS\\):.*\n" nil t)
                  (replace-match "" t t))
                (goto-char (point-min))
                (while (re-search-forward "^\\(\\*+\\) " nil t)
                  (replace-match (concat "*" (match-string 1) " ") t t))
                (let ((body (buffer-string)))
                  (with-current-buffer (get-buffer-create " *cg-month*")
                    (goto-char (point-max))
                    (insert "* " title "\n\n" body "\n\n"))))))
          (insert-buffer-substring (get-buffer " *cg-month*")))
        (let ((pdf (with-current-buffer (find-file-noselect temp)
                     (condition-case err
                         (org-latex-export-to-pdf)
                       (error
                        (when (get-buffer "*Org PDF LaTeX Output*")
                          (princ (with-current-buffer "*Org PDF LaTeX Output*"
                                   (buffer-string))))
                        (signal (car err) (cdr err)))))))
          (setq pdf (and pdf (expand-file-name pdf dir)))
          (unless (and pdf (file-exists-p pdf)) (error "No PDF created at %s" pdf))
          (rename-file pdf dest t)
          (message "Created %s" dest)))
    (when (file-exists-p temp) (delete-file temp))))
